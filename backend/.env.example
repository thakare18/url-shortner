MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=quickshorturl
# Generate once locally: go run ./cmd/keygen. Keep this key safe across restarts/deploys.
URL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_RANDOM_KEY
URL_ENCRYPTION_KEY_ID=v1
PUBLIC_BASE_URL=http://localhost:3000/s
# Render supplies PORT; the server binds to 0.0.0.0:$PORT automatically.
# PORT=8080
# ADDR=0.0.0.0:8080
# Atlas database user needs readWrite + dbAdmin on MONGODB_DATABASE for schema/index setup.
